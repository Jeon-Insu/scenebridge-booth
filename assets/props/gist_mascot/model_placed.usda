#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    float3 xformOp:scale = (0.6666666401757145, 0.6666666401757145, 0.6666666401757145)
    double3 xformOp:translate = (4.960596364315496e-05, -2.1030504662596282e-05, 1.3297107592330134e-17)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

    def Xform "Model" (
        prepend references = @./model.usdz@
    )
    {
        float xformOp:rotateX:studioUp = 90
        uniform token[] xformOpOrder = ["xformOp:rotateX:studioUp"]
    }
}

