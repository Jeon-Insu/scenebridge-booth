#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    float3 xformOp:scale = (0.8999999530613446, 0.8999999530613446, 0.8999999530613446)
    double3 xformOp:translate = (0.00035184964565226787, 7.780082118058007e-05, 6.705522201406678e-09)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

    def Xform "Model" (
        prepend references = @./model.usdz@
    )
    {
        float xformOp:rotateX:studioUp = 90
        uniform token[] xformOpOrder = ["xformOp:rotateX:studioUp"]
    }
}

