#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    float3 xformOp:scale = (0.833333300219643, 0.833333300219643, 0.833333300219643)
    double3 xformOp:translate = (7.74860351289894e-06, 9.810551611161418e-05, 1.3820120913701795e-17)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

    def Xform "Model" (
        prepend references = @./model.usdz@
    )
    {
        float xformOp:rotateX:studioUp = 90
        uniform token[] xformOpOrder = ["xformOp:rotateX:studioUp"]
    }
}

