#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    float3 xformOp:scale = (1.5000000335276134, 1.5000000335276134, 1.5000000335276134)
    double3 xformOp:translate = (1.7660670377180054e-05, 3.144331346696498e-05, 1.257526937810792e-17)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

    def Xform "Model" (
        prepend references = @./model.usdz@
    )
    {
        float xformOp:rotateX:studioUp = 90
        uniform token[] xformOpOrder = ["xformOp:rotateX:studioUp"]
    }
}

