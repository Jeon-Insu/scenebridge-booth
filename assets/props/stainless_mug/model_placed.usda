#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    float3 xformOp:scale = (0.05264402, 0.05264402, 0.05264402)
    double3 xformOp:translate = (0.0000531971725028966, -0.00004940275360124634, 0.050050828112117744)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

    def Xform "Model" (
        prepend references = @./model.usdz@
    )
    {
        float xformOp:rotateX:studioUp = 90
        uniform token[] xformOpOrder = ["xformOp:rotateX:studioUp"]
    }
}

